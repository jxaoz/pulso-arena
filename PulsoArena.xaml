<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pulso Arena" Width="1280" Height="850"
        MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#080A11" Foreground="#F0F5FC" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#72EBFF"/>
    <SolidColorBrush x:Key="Foreground" Color="#F0F5FC"/>
    <SolidColorBrush x:Key="Muted" Color="#A7B7CC"/>
    <SolidColorBrush x:Key="Line" Color="#243149"/>
    <Style TargetType="Button" x:Key="BaseButton">
      <Setter Property="Background" Value="#151D2D"/>
      <Setter Property="Foreground" Value="#F0F5FC"/>
      <Setter Property="BorderBrush" Value="#2B3A50"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".86"/><Setter TargetName="Frame" Property="BorderBrush" Value="#72EBFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".64"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#B3AFFE"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".43"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#85EEFF" Offset="0"/><GradientStop Color="#57CAFC" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
      <Setter Property="Foreground" Value="#051421"/><Setter Property="BorderBrush" Value="#96F9FF"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AFBCCF"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,11"/>
    </Style>
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Padding" Value="11,6"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EEF3FA"/><Setter Property="Background" Value="#141D2B"/><Setter Property="BorderBrush" Value="#334259"/>
      <Setter Property="CaretBrush" Value="#72EBFF"/><Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#72EBFF"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EBF0F8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <ControlTemplate x:Key="ScrollPage" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    <Style TargetType="ScrollBar">
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="#0C101A">
                  <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Template="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Focusable="False">
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bar" CornerRadius="3" Margin="3,0" MinHeight="24" Background="#414E64"/>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#64748E"/></Trigger></ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Template="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="#080A11">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0C101A" BorderBrush="#242E47" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False" Margin="18,25,18,20">
        <StackPanel DockPanel.Dock="Top" Margin="5,0,0,35" Orientation="Horizontal">
          <Border Width="38" Height="38" CornerRadius="11" Background="#151A2A" BorderBrush="#337496" BorderThickness="1" Margin="0,0,10,0">
            <Grid>
              <Rectangle Width="21" Height="8" RadiusX="4" RadiusY="4" Stroke="#72EBFF" StrokeThickness="2" Margin="0,0,5,9"/>
              <Rectangle Width="21" Height="8" RadiusX="4" RadiusY="4" Stroke="#7771FF" StrokeThickness="2" Margin="5,9,0,0"/>
            </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Pulso Arena" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="OTIMIZADOR WINDOWS" Foreground="#A3B0C2" FontSize="8.5" FontWeight="SemiBold" Margin="1,2,0,0"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="Navigation" DockPanel.Dock="Top"/>
        <StackPanel DockPanel.Dock="Bottom">
          <StackPanel x:Name="SecondaryNav"/>
          <Border BorderBrush="#29364A" BorderThickness="0,1,0,0" Margin="2,12,2,0" Padding="8,15,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="#58EDB6" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock Text="Processamento local" Foreground="#A3B0C2" FontSize="12"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="*"/><RowDefinition Height="41"/></Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="#222C3E" BorderThickness="0,0,0,1" Background="#0C101A" Padding="31,0">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Right" BorderBrush="#294E67" BorderThickness="1" Background="#101F2B" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
            <TextBlock x:Name="SessionLabel" Foreground="#72EBFF" Text="WINDOWS · 64 BITS" FontSize="10" FontWeight="SemiBold"/>
          </Border>
          <TextBlock x:Name="PageCaption" Text="Visão geral" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="PageBody" Margin="30,25,30,26"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#0C101A" BorderBrush="#253044" BorderThickness="0,1,0,0" Padding="30,0">
        <DockPanel>
          <ProgressBar x:Name="WorkIndicator" DockPanel.Dock="Right" Width="82" Height="4" Margin="15,0,0,0" IsIndeterminate="True" Foreground="#72EBFF" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Text="Pronto" Foreground="#A3B0C2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
